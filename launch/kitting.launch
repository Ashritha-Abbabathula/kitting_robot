<launch>
  <!-- Run tonight (or any time) with defaults: safe, simulated arm.
       Tomorrow at the lab: roslaunch kitting_robot kitting.launch simulate:=false port:=/dev/ttyUSB0 -->

  <arg name="camera_index" default="0" />
  <arg name="simulate" default="true" />
  <arg name="port" default="/dev/ttyUSB0" />
  <arg name="rate_hz" default="5.0" />

  <node name="perception_node" pkg="kitting_robot" type="perception_node.py" output="screen">
    <param name="camera_index" value="$(arg camera_index)" />
    <param name="rate_hz" value="$(arg rate_hz)" />
  </node>

  <node name="notify_node" pkg="kitting_robot" type="notify_node.py" output="screen" />

  <node name="dobot_node" pkg="kitting_robot" type="dobot_node.py" output="screen">
    <param name="simulate" value="$(arg simulate)" />
    <param name="port" value="$(arg port)" />
  </node>
</launch>
